# A libeo loaded earlier in this Lich session may be older than this script
# needs; load it again unless the one loaded is new enough.
Script.loadlib('libeo') unless defined?(::EO::VERSION) && Gem::Version.new(::EO::VERSION) >= Gem::Version.new('0.3.0')
EO.require('0.3.0')
exit unless EO.require_lich('5.22.0')

require 'yaml'
require 'securerandom'
require 'terminal-table'

# Data Class
module Ecleanse
  class Data
    attr_accessor :settings, :policy, :did_something, :event_stack, :cloud, :globe, :web, :runestone,
                  :recover_stuff, :recover_stuff_seq, :creature, :bad_targets, :hive_trap_room

    def initialize(settings)
      @settings = settings
      @policy = EO::Cleanse::Policy.new(**settings.transform_keys(&:to_sym))
      @did_something = false
      @event_stack = []
      @bad_targets = EO::Cleanse::BadTargets.new

      @settings[:script_list] = @settings[:stop_scripts].split(",").map(&:strip)
      @settings[:script_list] << "go2" unless @settings[:script_list].include?("go2")

      # action variables
      @cloud = nil
      @globe = nil
      @runestone = nil
      @web = nil

      # hook_variables
      @recover_stuff = {}
      @recover_stuff_seq = 0
      @creature = nil
      @hive_trap_room = nil
    end
  end
end

# UI Setup
module Ecleanse
  # ;ecleanse setup: a Lich WebUI settings form with the same options as the
  # old GTK window. Save & Close writes the settings file if anything changed;
  # Cancel or closing the window discards. The class also backs
  # ;ecleanse list, which works without the WebUI.
  class Setup
    attr_accessor :settings

    # Lich keeps this class between runs in a session; start each run clean.
    constants(false).each { |name| remove_const(name) }

    PAGE_ID = 'ecleanse-setup'
    # Stun maneuvers: only one of these may be on at a time.
    STUN_EXCLUSIVE = %i[use_stance1 use_stance2 use_flee use_hide].freeze

    # Checkbox layout, column by column, as in the old window: [key, label, tooltip].
    MISC_COLUMNS = [
      [[:recover_disarmed, 'Recover Disarmed Weapons'], [:use_berserk_webbed, 'Use Berserk when Webbed'],
       [:determination, 'Use Sigil of Determination'], [:itchy_curse, 'Manage Itchy Curse']],
      [[:cleanse_disease, 'Cure Disease', 'Uses undisease (113)'], [:cleanse_poison, 'Cure Poison', 'Uses unpoison (114)'],
       [:cleanse_grounded, 'Cleanse Grounded', 'Attempts to clear Rooted or Pressed'],
       [:cleanse_magical, 'Cleanse Magical', 'Attempts to cleanse - Confusion, Vertigo, Sounds, or Thought Lash using spells 417, 119, or 1218 if known']],
      [[:dispel_clouds, 'Dispel Clouds'], [:dispel_magic, 'Dispel Magic'], [:avoid_webs, 'Dispel Webs']],
      [[:hive_traps_apparatus, 'Disarm Hive Apparatus'], [:hive_traps_ground, 'Disarm Hive Ground'],
       [:break_runestone, 'Break Runestone', 'Attacks pale hovering runestones (Onslaught)']],
    ].freeze
    STUN_COLUMNS = [
      [[:use_stunned_barkskin, 'Barkskin (605)'], [:use_berserk_stunned, 'Berserk'], [:use_stunned1040, "Troubadour's Rally (1040)"]],
      [[:use_stance1, 'Stunman Stance1'], [:use_stance2, 'Stunman Stance2'], [:use_1635, 'Divine Intervention (1635)']],
      [[:use_flee, 'Stunman Flee'], [:use_hide, 'Stunman Hide']],
    ].freeze
    DISARMED_COLUMNS = [
      [[:use_709, 'Grasp of the Grave (709)'], [:use_619, 'Mass Calm (619)'], [:use_213, 'Minor Sanctuary (213)']],
      [[:use_1011, 'Song of Peace (1011)'], [:use_9811, 'Symbol of Sleep']],
      [[:use_140, 'Wall of Force (140)'], [:use_919, "Wizard's Shield (919)"]],
    ].freeze

    @@categories = {
      general: {
        cleanse_magical: { default: false },
        cleanse_grounded: { default: false },
        cleanse_poison: { default: false },
        cleanse_disease: { default: false },
        recover_disarmed: { default: false },
        dispel_clouds: { default: false },
        dispel_magic: { default: false },
        avoid_webs: { default: false },
        use_berserk_webbed: { default: false },
        hive_traps_apparatus: { default: false },
        hive_traps_ground: { default: false },
        break_runestone: { default: false },
        stop_scripts: { default: '' },
        script_list: { default: [] },
        determination: { default: false },
        itchy_curse: { default: false },
        safe_room: { default: '' },
        use_stunned_barkskin: { default: false },
        use_berserk_stunned: { default: false },
        use_stunned1040: { default: false },
        use_stance1: { default: false },
        use_stance2: { default: false },
        use_flee: { default: false },
        use_hide: { default: false },
        use_709: { default: false },
        use_619: { default: false },
        use_213: { default: false },
        use_1011: { default: false },
        use_9811: { default: false },
        use_140: { default: false },
        use_919: { default: false },
        use_1635: { default: false },
        version: { default: '' },
      }
    }

    extend EO::Settings::Registry

    # True when Lich can open a WebUI window for this script.
    def self.available? = EO::Settings.available?(:SettingsForm)

    def initialize(settings)
      @settings = settings
      @owner = Script.current

      # Capture starting settings
      @original_settings = Marshal.load(Marshal.dump(settings))

      # Get script version
      @settings[:version] = @version = EO.script_version

      Setup.fill_defaults(@settings)
      Setup.prune(@settings)
    end

    # Options this character cannot use: greyed out and switched off, as in
    # the old window.
    def unavailable
      @unavailable ||= begin
        dispel = [417, 1218, 119].any? { |s| Spell[s].known? }
        cleave = CMan.known?("Spell Cleave") || CMan.known?("Spell Thieve")
        stun = CMan.stun_maneuvers
        {
          cleanse_disease: !Spell[113].known?,
          cleanse_poison: !Spell[114].known?,
          use_berserk_webbed: !CMan.known?("Berserk"),
          determination: !Spell["Sigil of Determination"].known?,
          cleanse_grounded: !(CMan.known?("Retreat") || Feat.known?("escapeartist")),
          cleanse_magical: !dispel,
          dispel_clouds: !dispel,
          dispel_magic: !dispel && !cleave,
          avoid_webs: ![209, 417, 1218, 119].any? { |s| Spell[s].known? } && !Feat.known?("escapeartist") && !cleave,
          use_stunned_barkskin: !Spell[605].known?,
          use_berserk_stunned: !CMan.known?("Berserk"),
          use_stunned1040: !Spell[1040].known?,
          use_stance1: stun < 2,
          use_stance2: stun < 4,
          use_flee: stun < 5,
          use_hide: stun < 5,
          use_709: !Spell[709].known?,
          use_619: !Spell[619].known?,
          use_213: !Spell[213].known?,
          use_1011: !Spell[1011].known?,
          use_9811: !Spell[9811].known?,
          use_140: !Spell[140].known?,
          use_919: !Spell[919].known?,
          use_1635: !Spell[1635].known?,
        }.select { |_, off| off }
      end
    end

    def disabled?(key) = unavailable.key?(key)

    def start
      unavailable.each_key { |key| @settings[key] = false }
      setup = self
      form = nil
      form = Lich::WebUI::SettingsForm.new(
        owner: @owner, id: PAGE_ID, title: "Ecleanse Setup v#{@version}", values: @settings, fields: fields,
        props: { size: [800, 500], viewport: true },
        normalize: ->(draft) { setup.normalize(draft) },
        layout: ->(ui, field, save) { setup.render(ui, field, save, -> { form.close }) }
      )
      result = form.show.wait
      if result.nil?
        respond
        Lich::Messaging.msg('plain', " Ecleanse UI closed WITHOUT saving any changes")
        Lich::Messaging.msg('plain', " Use the Save & Close button to save changes")
        respond
      elsif result == @original_settings
        respond
        Lich::Messaging.msg('plain', " Nothing to save. No changes were made.")
        respond
      else
        filename = EO::Settings.save_profile('ecleanse', result)
        respond
        Lich::Messaging.msg('plain', " Settings saved to file: #{filename}.")
        respond
      end
      result
    end

    # One form field per checkbox and text box; stun maneuvers are exclusive.
    def fields
      checks = (MISC_COLUMNS + STUN_COLUMNS + DISARMED_COLUMNS).flatten(1).map do |key, label, tip|
        field = { key: key, type: :checkbox, label: label, disabled: disabled?(key) }
        field[:tooltip] = tip if tip
        field[:exclusive] = :stun if STUN_EXCLUSIVE.include?(key)
        field
      end
      checks + [
        { key: :stop_scripts, type: :text_input, placeholder: 'list of scripts to pause eg - bigshot, eloot, go2' },
        { key: :safe_room, type: :text_input, placeholder: 'room number or name',
          tooltip: 'If left empty will run to nearest town or sanctuary.' },
      ]
    end

    # Strips text, keeps unusable options off and at most one stun maneuver on.
    def normalize(draft)
      %i[stop_scripts safe_room].each { |key| draft[key] = draft[key].to_s.strip }
      (MISC_COLUMNS + STUN_COLUMNS + DISARMED_COLUMNS).flatten(1).each do |key, _|
        draft[key] = draft[key] && !disabled?(key) ? true : false
      end
      first = STUN_EXCLUSIVE.find { |key| draft[key] }
      (STUN_EXCLUSIVE - [first]).each { |key| draft[key] = false }
      draft
    end

    # A group of checkbox columns; +columns+ is a list of [key, label, tip] lists.
    def check_columns(ui, field, key, columns)
      ui.columns(key: key, count: columns.size, gap: 12, row_align: :start) do
        columns.each_with_index do |items, i|
          ui.stack(slot: i.to_s, key: "#{key}-#{i}", gap: 4) do
            items.each { |k, _| field.call(ui, k) }
          end
        end
      end
    end

    def render(ui, field, save, cancel)
      setup = self
      ui.stack(key: 'ecleanse', gap: 6, margin: 8, fill: true) do
        ui.scroll(key: 'body', fill: true) do
          ui.stack(key: 'panels', gap: 8) do
            ui.group(key: 'scripts', label: 'Scripts') do
              ui.grid(key: 'scripts-row', cols: 2, homogeneous: false, expand_columns: [2], column_gap: 10) do
                ui.text(key: 'l-stop', content: 'Scripts to Pause')
                field.call(ui, :stop_scripts)
              end
            end
            ui.group(key: 'misc', label: 'Misc') do
              ui.stack(key: 'misc-body', gap: 6) do
                setup.check_columns(ui, field, 'misc-cols', MISC_COLUMNS)
                ui.grid(key: 'safe-row', cols: 2, homogeneous: false, expand_columns: [2], column_gap: 10) do
                  ui.text(key: 'l-safe', content: 'Itchy Curse Safe Room')
                  field.call(ui, :safe_room)
                end
              end
            end
            ui.group(key: 'stun', label: 'Stun Recovery') do
              setup.check_columns(ui, field, 'stun-cols', STUN_COLUMNS)
            end
            ui.group(key: 'disarmed', label: 'Cast in Room when Disarmed') do
              setup.check_columns(ui, field, 'disarmed-cols', DISARMED_COLUMNS)
            end
          end
        end
        ui.columns(key: 'footer', count: 3, weights: [5, 1, 1], compact: true, row_align: :center, gap: 6) do
          ui.text(slot: '0', key: 'footer-text', emphasis: :subtle, content: 'Cancel or closing the window discards changes.')
          ui.button(slot: '1', key: 'cancel', label: 'Cancel', on: { activate: ->(_ev) { cancel.call } })
          save.call(ui, slot: '2', variant: :primary)
        end
      end
    end

    def list(cat_to_list: 'all')
      indent_size = 2
      print_array =
        proc do |key, value, indent|
          _respond("#{' ' * indent_size * indent.to_i}#{key}:")
          value.sort!.each { |entry| _respond("#{' ' * indent_size * (indent.to_i + 1)}#{value.index(entry) + 1}. #{entry}") }
        end

      print_value = proc { |key, value, indent| _respond("#{' ' * indent_size * indent.to_i}#{key}: #{value}") }

      categories = cat_to_list == 'all' ? @@categories.keys.map(&:to_s) : [cat_to_list]
      if $frontend == 'stormfront'
        output = "<output class=\"mono\"/>\n"
      else
        output = String.new
      end
      categories.each do |opt|
        _respond("#{output}") if !output.empty?
        _respond("#{monsterbold_start}= #{opt.capitalize} =#{monsterbold_end}\n")
        @@categories[opt.to_sym].each do |id, _|
          value = @settings[id]
          value.class == Array ? print_array.call(id, value, 1) : print_value.call(id, value, 1)
        end
      end
      if $frontend == 'stormfront'
        output = "<output class=\"\"/>\n"
        _respond("#{output}")
      end
    end
  end
end

# Load/Save profiles
module Ecleanse
  @@data ||= nil

  def self.data
    @@data
  end

  def self.load(settings)
    @@data = Data.new(settings)
  end

  def self.load_defaults
    {
      :cleanse_magical      => CharSettings['cleanse_magical'] || false,
      :cleanse_grounded     => CharSettings['cleanse_grounded'] || false,
      :cleanse_poison       => CharSettings['cleanse_poison'] || false,
      :cleanse_disease      => CharSettings['cleanse_disease'] || false,
      :recover_disarmed     => CharSettings['recover_disarmed'] || false,
      :dispel_clouds        => false,
      :dispel_magic         => false,
      :avoid_webs           => CharSettings['avoid_webs'] || false,
      :break_runestone      => CharSettings['break_runestone'] || false,
      :use_berserk_webbed   => false,
      :stop_scripts         => CharSettings['stop_scripts'] || '',
      :script_list          => [],
      :determination        => CharSettings['determination'] || false,
      :use_stunned_barkskin => false,
      :use_berserk_stunned  => false,
      :use_stunned1040      => false,
      :use_stance1          => false,
      :use_stance2          => false,
      :use_flee             => false,
      :use_hide             => false,
      :use_709              => false,
      :use_619              => false,
      :use_213              => false,
      :use_1011             => false,
      :use_9811             => false,
      :use_140              => false,
      :use_919              => false,
      :version              => '',
    }
  end

  def self.load_profile = EO::Settings.load_profile('ecleanse') || Ecleanse.load_defaults
end

# Main Script Methods. The cures, the hazards, the disarm search and the
# traps are libeo's (EO::Cleanse); each action here decides whether to
# act, pauses the other scripts, and says what happened.
module Ecleanse
  module Action
    def self.settings = Ecleanse.data.settings
    def self.policy = Ecleanse.data.policy
    def self.sigil = Ecleanse.data.settings[:determination]

    def self.avoid_webs
      return unless settings[:avoid_webs]

      Action.hazard(Ecleanse.data.web, :web)
      Ecleanse.data.web = nil
    end

    def self.avoid_globe
      return unless settings[:dispel_magic]

      Action.hazard(Ecleanse.data.globe, :globe)
      Ecleanse.data.globe = nil
    end

    def self.dispel_cloud
      return unless settings[:dispel_magic]

      Action.hazard(Ecleanse.data.cloud, :cloud)
      Ecleanse.data.cloud = nil
    end

    # TARGET the hazard before pausing anything: a player's own is refused,
    # and is not tried again.
    def self.hazard(obj, kind)
      return if obj.nil?
      return unless EO::Cleanse::Hazards.clearable?(obj, kind, determination: sigil)

      unless EO::Cleanse::Hazards.aim(obj)
        Ecleanse.data.bad_targets << obj.id
        return
      end

      System.scripts_pause
      EO::Cleanse::Hazards.clear(obj, kind, determination: sigil, aimed: true)
    end

    def self.avoid_runestone
      return unless settings[:break_runestone]

      stone = Ecleanse.data.runestone
      Ecleanse.data.runestone = nil
      return if stone.nil?

      unless EO::Cleanse::Hazards.target(stone)
        Ecleanse.data.bad_targets << stone.id
        return
      end

      System.scripts_pause
      EO::Cleanse::Hazards.break_runestone(stone, aimed: true)
    end

    def self.determination
      return unless settings[:determination]
      return unless EO::Cleanse.sigil?

      System.scripts_pause
      EO::Cleanse.cast_sigil
    end

    def self.remove_poison
      return unless settings[:cleanse_poison]
      return unless EO::Cleanse::Afflictions.curable?(:poison, determination: sigil)

      System.scripts_pause
      EO::Cleanse::Afflictions.cure(:poison, determination: sigil)
    end

    def self.remove_disease
      return unless settings[:cleanse_disease]
      return unless EO::Cleanse::Afflictions.curable?(:disease, determination: sigil)

      System.scripts_pause
      EO::Cleanse::Afflictions.cure(:disease, determination: sigil)
    end

    def self.remove_magical
      return unless settings[:cleanse_magical]
      return unless EO::Cleanse::Afflictions.curable?(:dispel, determination: sigil)

      System.scripts_pause
      EO::Cleanse::Afflictions.dispel(determination: sigil)
    end

    def self.remove_grounded
      return unless settings[:cleanse_grounded]
      return unless EO::Cleanse::Afflictions.ungroundable?

      System.scripts_pause
      EO::Cleanse::Afflictions.unground
    end

    def self.remove_stun
      means = EO::Cleanse::Afflictions.stun_means(policy)
      return if means.nil?

      System.scripts_pause
      EO::Cleanse::Afflictions.unstun(means)
    end

    def self.remove_web_bound
      return unless settings[:avoid_webs] || settings[:use_berserk_webbed]

      means = EO::Cleanse::Afflictions.web_means(policy)
      return if means.nil?

      System.scripts_pause
      EO::Cleanse::Afflictions.unweb(means)
    end

    # Make the room safer, keep whatever another script slipped in paused,
    # and stand defensive: the start of every recovery.
    def self.brace
      EO::Cleanse::Afflictions.settle_room(policy)
      System.scripts_pause
      Lich::Gemstone::Stance.change('defensive')
    end

    # Files a disarm under recover_stuff with the ids in hand right now, so
    # the weapon that comes back is one that was not already there. Returns
    # its key, or nil with recovery off. track: false for what RECOVER ITEM
    # cannot get back later (webbing, telekinetic); the rest go on the saved
    # list now, so being stopped or dying first cannot lose them.
    def self.record_disarm(noun, track: true)
      return nil unless settings[:recover_disarmed]

      disarm_id = track ? EO::Cleanse::Disarms.add(noun) : nil
      Action.queue_recover(Room.current, noun, disarm_id)
    end

    def self.queue_recover(room, noun, disarm_id)
      key = Ecleanse.data.recover_stuff_seq
      Ecleanse.data.recover_stuff_seq += 1
      Ecleanse.data.recover_stuff[key] = { room: room, noun: noun, known_ids: EO::Cleanse::Disarms.hands, disarm_id: disarm_id }
      key
    end

    def self.recover(key)
      details = Ecleanse.data.recover_stuff.delete(key)
      return if details.nil? # already handled or never recorded (e.g. feature was off)
      return unless EO::Cleanse::Disarms.tracked?(details[:disarm_id]) # already turned up while searching for another disarm

      System.scripts_pause

      known_ids = details[:known_ids]
      item = details[:noun]
      disarm_id = details[:disarm_id]
      room_id = details[:room]&.id

      EO.say("yellow", " ########## DISARMED!!! ##########")
      EO.say("yellow", " ## Room#: #{room_id}")
      EO.say("yellow", " ## Room Name: #{Array(details[:room]&.title).first}")
      EO.say("yellow", " ## Looking for: #{item}")
      EO.say("yellow", " ########## DISARMED!!! ##########")
      EO.go2(room_id) if room_id

      stops = EO::Cleanse::Disarms.prepare(policy)

      if EO::Cleanse::Disarms.servant
        lines = EO::Cleanse.command("sense", /You open your soul to the lesser/, silent: true, quiet: true)
        fput "stop 213" if lines.any? { |l| l =~ /An obvious presence of peace saturates the area and a feeling of safety overwhelms you/ }
        EO::Cleanse::Disarms.remove(disarm_id)
        return
      end

      Action.brace

      # Only a bonded weapon can be back before RECOVER ITEM is sent; for
      # anything else a weapon in hand now is another script's doing.
      stashes = 0
      if EO::Cleanse::Disarms.await_bonded(known_ids, item)
        EO::Cleanse::Disarms.remove(disarm_id)
      else
        search = EO::Cleanse::Disarms.search(item, known_ids: known_ids, room_id: room_id, id: disarm_id) do |event, found|
          case event
          when :other then EO.say("yellow", " Recovered #{found} while looking for #{item}. Still searching.")
          when :inferred then EO.say("yellow", " No recovery message seen, but hand state changed - treating #{item} as recovered.")
          end
        end
        case search.outcome
        when :cannot_search
          EO.say("yellow", " Unable to search. #{item} is in room #{room_id}. Use #{$lich_char}#{Script.current.name} disarmrecover to try again.")
        when :nothing_here
          EO.say("yellow", " Nothing to recover in room #{room_id}. No longer tracking disarms there.")
        end
        stashes = search.stashes
        EO.settle
      end

      EO::Cleanse::Disarms.restore_hands(stashes)
      EO::Cleanse::Disarms.stop(stops)
    end

    def self.recover_weapon_webbing(key)
      details = Ecleanse.data.recover_stuff.delete(key)
      return if details.nil?

      System.scripts_pause
      stops = EO::Cleanse::Disarms.prepare(policy)
      Action.brace
      EO::Cleanse::Disarms.pry(details[:noun])
      EO.settle
      ReadyList.check(silent: true, quiet: true) unless ReadyList.valid?
      EO::Cleanse::Disarms.stop(stops)
    end

    def self.telekinetic_recover(key)
      # Telekinetic Disarm is cast in Moonsedge - Savant spell 1406
      details = Ecleanse.data.recover_stuff.delete(key)
      return if details.nil?

      System.scripts_pause
      Action.brace
      EO::Cleanse::Disarms.telekinetic(details[:noun], details[:known_ids])
      EO.settle
      ReadyList.check(silent: true, quiet: true) unless ReadyList.valid?
    end

    def self.sanctum_recover
      # Unholy Quickening by Lithe Veiled Sentinels in the Sanctum
      return unless settings[:recover_disarmed]

      System.scripts_pause
      EO.settle
      Action.brace
      EO::Cleanse::Disarms.clench(Ecleanse.data.creature)
    end

    def self.use_vat
      # A bite/spit maneuver from a Shambling Lurk in the Sanctum
      vat_room = EO::Cleanse::Traps.vat_room
      if vat_room.nil?
        EO.say("yellow", " The infected wound is cleaned at the Sanctum's vat, which this map does not know.")
        return
      end

      System.scripts_pause
      current_room = Room.current.id
      EO.go2(vat_room)
      EO::Cleanse::Traps.clean_vat
      EO.go2(current_room)
    end

    def self.hive_traps_apparatus = Action.hive_trap(:hive_traps_apparatus)

    def self.hive_traps_ground = Action.hive_trap(:hive_traps_ground)

    # SEARCH out the trap where it went off; disarm an apparatus once found.
    # The room is forgotten unless the search was cut short by something
    # that clears by itself, and the trap announces itself again.
    def self.hive_trap(kind)
      return unless settings[kind]
      return if Script.running?('go2')

      room_id = Ecleanse.data.hive_trap_room
      return unless room_id && Room.current.id == room_id

      System.scripts_pause
      outcome = EO::Cleanse::Traps.search(room_id)
      EO::Cleanse::Traps.disarm(room_id) if outcome == :found && kind == :hive_traps_apparatus
      Ecleanse.data.hive_trap_room = nil unless EO::Cleanse::Traps.retry?(outcome)
      EO.settle
    end

    def self.itchy_curse
      return unless settings[:itchy_curse]

      cursed_room = Room.current.id
      safe_place = EO::Cleanse::Traps.safe_room(settings[:safe_room])

      System.scripts_pause
      Script.kill("go2") if Script.running?("go2")
      # the rash is waited out on the way there
      Script.start("go2", "#{safe_place} --disable-confirm")
      EO::Cleanse::Traps.wait_out_rash
      EO.go2(cursed_room)
    end

    # ;ecleanse last disarm - lists what is still lost, newest first.
    def self.disarm_report
      disarms = EO::Cleanse::Disarms.list
      EO.say("yellow", " No unrecovered disarms.") if disarms.empty?
      disarms.reverse_each do |entry|
        EO.say("yellow", " #{entry[:item]} - Room #{entry[:room]} #{entry[:title]} - #{(Time.now.to_i - entry[:at]) / 60} min ago")
      end
    end

    # ;ecleanse disarmrecover - goes back for the most recent unrecovered disarm.
    def self.disarm_recover
      entry = EO::Cleanse::Disarms.list.last
      if entry.nil?
        EO.say("yellow", " No unrecovered disarms to go back for.")
        return
      end
      if dead?
        EO.say("yellow", " Can't go back for #{entry[:item]} while dead. It is in room #{entry[:room]}.")
        return
      end

      # Room[nil] is a fuzzy title search rather than a miss, and an unmapped
      # disarm room is saved with no id.
      room = entry[:room].nil? ? nil : Room[entry[:room]]
      if room.nil?
        EO.say("yellow", " Can't find the room #{entry[:item]} was lost in (#{entry[:title]}) on the map.")
        return
      end

      Action.recover(Action.queue_recover(room, entry[:item], entry[:id]))
    end
  end

  module System
    def self.deadmans_switch
      # Kill script if dead
      Thread.new { loop { Script.self.kill if dead?; sleep(5); } }
    end

    def self.scripts_pause
      Ecleanse.data.settings[:script_list].each { |script| Script.pause(script) if Script.running?(script) }
      Ecleanse.data.did_something = true
    end

    def self.scripts_resume
      Ecleanse.data.settings[:script_list].each { |script| Script.unpause(script) if Script.paused?(script) }
      Ecleanse.data.did_something = false
    end

    # A line Lich knows as a disarm, the sanctum's transformation, the
    # infected wound, a hive trap, the itchy curse or the entangling bind,
    # queued as work. Runs on the game thread, ahead of other scripts' text
    # handling, so the hands are read before anyone moves something into
    # them; must not raise, or Lich drops the hook.
    def self.heard(event, data)
      queue = Ecleanse.data.event_stack
      case event
      when :disarm_seen
        key = Action.record_disarm(data[:noun], track: data[:kind] == :recover)
        queue << { event: data[:kind], key: key } unless key.nil?
      when :sanctum_transform
        Ecleanse.data.creature = data[:noun]
        queue << :sanctum_recover unless queue.include?(:sanctum_recover)
      when :infected_wound
        queue << :use_vat unless queue.include?(:use_vat)
      when :hive_trap
        Ecleanse.data.hive_trap_room = Room.current.id
        kind = data[:kind] == :ground ? :hive_traps_ground : :hive_traps_apparatus
        queue << kind unless queue.include?(kind)
      when :itchy_curse
        queue << :itchy_curse unless queue.include?(:itchy_curse)
      when :entangled
        queue << :remove_web_bound unless queue.include?(:remove_web_bound)
      end
    end

    def self.set_hooks
      # Lich's own message definitions, matched here in step with the line
      # rather than on its event thread.
      messages = Lich::Gemstone::Combat::Messages
      ecleanse_status = proc { |server|
        begin
          families = messages.table.by_name.values_at(:disarm, :hazard).compact
          messages.scan(server, families: families).each { |event, data| System.heard(event, data) }
        rescue StandardError => e
          Lich.log("ecleanse: #{e.class}: #{e.message}")
        end
        server
      }
      DownstreamHook.add('ecleanse_status', ecleanse_status, priority: 100)

      # Lich won't start a second copy of a running script, so while this one
      # is up it has to pick these commands off before Lich sees them. The work
      # is queued rather than done here because this runs on the client's thread.
      disarm_command = /^(?:<c>)?#{$lich_char_regex}(?:force\s+)?#{Regexp.escape(Script.current.name)}\s+(disarmrecover|last\s+disarm)\s*$/i
      ecleanse_command = proc { |client|
        if client =~ disarm_command
          event = Regexp.last_match(1).casecmp?('disarmrecover') ? :disarm_recover : :disarm_report
          Ecleanse.data.event_stack << event unless Ecleanse.data.event_stack.include?(event)
          nil
        else
          client
        end
      }
      UpstreamHook.add('ecleanse_command', ecleanse_command)

      before_dying {
        DownstreamHook.remove('ecleanse_status')
        UpstreamHook.remove('ecleanse_command')
        Ecleanse.data.settings[:script_list].each { |script| Script.unpause(script) if Script.paused?(script) }
      }
    end
  end

  module Util
    def self.help
      EO.help([
                ['setup', 'Setup window'],
                ['load', 'Reloads all settings'],
                ['list', 'Lists all settings'],
                ['last disarm', "Lists disarms not yet recovered (up to #{EO::Cleanse::Disarms::MAX})"],
                ['disarmrecover', 'Goes back for the most recent disarm not yet recovered'],
              ])
    end
  end

  def self.main_loop
    loop do
      while Ecleanse.data.event_stack.any?
        current_event = Ecleanse.data.event_stack.shift
        # recover-type events are queued as { event:, key: } so they're
        # dispatched against the exact recover_stuff entry they belong to,
        # rather than a bare symbol that would fall back to picking
        # whatever's oldest in recover_stuff.
        if current_event.is_a?(Hash)
          Action.send(current_event[:event], current_event[:key])
        else
          Action.send(current_event)
        end
      end

      bad = Ecleanse.data.bad_targets
      Ecleanse.data.cloud = EO::Cleanse::Hazards.cloud(bad)
      Ecleanse.data.globe = EO::Cleanse::Hazards.globe(bad)
      Ecleanse.data.runestone = EO::Cleanse::Hazards.runestone(bad)
      Ecleanse.data.web = EO::Cleanse::Hazards.web(bad)

      # A list, not a Hash: two conditions true at once would be one key.
      conditions = [
        [EO::Cleanse::Afflictions.poisoned?, :remove_poison],
        [checkdisease, :remove_disease],
        [checkstunned, :remove_stun],
        [checkwebbed || checkbound, :remove_web_bound],
        [EO::Cleanse::Afflictions.grounded?, :remove_grounded],
        [EO::Cleanse::Afflictions.magical?, :remove_magical],
        [Ecleanse.data.cloud, :dispel_cloud],
        [Ecleanse.data.globe, :avoid_globe],
        [Ecleanse.data.runestone, :avoid_runestone],
        [Ecleanse.data.web, :avoid_webs],
        [Ecleanse.data.settings[:determination] && EO::Cleanse.sigil_wounds?, :determination]
      ]

      # Add events if conditions are met
      conditions.each do |condition, event|
        Ecleanse.data.event_stack << event if condition && !Ecleanse.data.event_stack.include?(event)
      end

      System.scripts_resume if Ecleanse.data.did_something
      sleep 0.2
    end
  end

  # A Data from an earlier version, still held this session, lacks the policy.
  unless Ecleanse.data.respond_to?(:policy)
    Ecleanse.load(Ecleanse.load_profile)
  end

  case Script.current.vars[0]
  when /^setup$/i
    Ecleanse::Setup.new(Ecleanse.data.settings).start
    Ecleanse.load(Ecleanse.load_profile)
  when /^disarmrecover$/i
    before_dying { Ecleanse::System.scripts_resume }
    Ecleanse::Action.disarm_recover
  when /load/
    Ecleanse.load(Ecleanse.load_profile)
  when /list/
    Ecleanse::Setup.new(Ecleanse.data.settings).list
  when /last disarm/
    Ecleanse::Action.disarm_report
  when nil
    Ecleanse.data.did_something = false
    Ecleanse.data.event_stack = []
    Ecleanse::System.deadmans_switch
    Ecleanse::System.set_hooks
    Ecleanse.main_loop
  else
    Ecleanse::Util.help
  end
end
