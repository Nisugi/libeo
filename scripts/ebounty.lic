      @@categories[:general][:illy_resting]     = { default: '156, 638, 728, 188, 13362, 601, 24555' }
      @@categories[:general][:vaalor_resting]   = { default: '3486, 10374, 3519, 3542' }
      @@categories[:general][:landing_resting]  = { default: '1263, 318, 477, 8859, 288, 228, 1259' }
      @@categories[:general][:zul_resting]      = { default: '1005, 5751' }
      @@categories[:general][:hw_resting]       = { default: '21951,21940' }
      @@categories[:general][:contempt_resting] = { default: '' }
    else
      @@categories[:general][:icemule_resting]  = { default: '21689, 2468, 3449, 3428, 2300, 3365' }
      @@categories[:general][:teras_resting]    = { default: '1844, 1932' }
      @@categories[:general][:kf_resting]       = { default: '28813, 28950, 28916' }
      @@categories[:general][:fwi_resting]      = { default: '3668, 28742, 18258, 17587' }
      @@categories[:general][:rr_resting]       = { default: '10861, 10855, 28717' }
      @@categories[:general][:solhaven_resting] = { default: '14234, 1481, 5732, 1438, 1572' }
      @@categories[:general][:illy_resting]     = { default: '156, 638, 728, 188, 13362, 601, 24555' }
      @@categories[:general][:vaalor_resting]   = { default: '3486, 10374, 3519, 3542' }
      @@categories[:general][:landing_resting]  = { default: '1263, 318, 477, 8859, 288, 228, 1259' }
      @@categories[:general][:zul_resting]      = { default: '1005, 5751' }
      @@categories[:general][:hw_resting]       = { default: '29870, 29881' }
      @@categories[:general][:contempt_resting] = { default: '35603' }
    end

    # True when Lich can open a WebUI window for this script.
    def self.available?
      defined?(Lich::WebUI) && Lich::WebUI.respond_to?(:presentation_enabled?) && Lich::WebUI.presentation_enabled? &&
        defined?(Lich::WebUI::ListSettingsForm)
    end

    def self.get_category(key)
      @@categories.each { |category, data| return category unless data[key].nil? }
      nil
    end

    def self.get_setting(key)
      cat = Setup.get_category(key)
      return nil if cat.nil?

      @@categories[cat].each { |setting, data| return data if setting == key }
      nil
    end

    # ListSettingsForm keys rows by position and seeds each viewer's table
    # selection only once, so after Add or Delete the window would keep
    # highlighting a row the form no longer has selected (and Delete would do
    # nothing). Clearing that viewer's selection keeps the two in step.
    @form_class = nil

    def self.form_class
      @form_class ||= Class.new(Lich::WebUI::ListSettingsForm) do
        private

        def render_field(tree, field, refs, **overrides)
          ref = super
          (@tables ||= {})[field[:key]] = ref if field && @lists.key?(field[:key])
          ref
        end

        def change_list(key, action, event)
          super
          table = @tables&.[](key)
          @page.set(table.cid, :selected, [], viewer: event.viewer_id) if table
        end
      end
    end

    def initialize(settings)
      @owner = Script.current
      @script_ver = EBounty.get_script_version
      @settings = settings

      # set default values if they don't exist
      @@categories.each do |_, data|
        data.each { |key, value| @settings[key] = value[:default].dup if @settings[key].to_s.empty? }
      end

      # remove settings that doesn't exist
      @settings.delete_if { |key, _| next Setup.get_category(key).nil? }
    end

    # ---------------------------------------------------------- lifecycle --

    # Opens the window and waits. Save & Close returns the edited settings, which
    # are saved to the profile; Cancel or closing the window discards them.
    def start
      result = form.show.wait
      if result
        apply(result)
        EBounty.msg("info", " Setup saved.")
      else
        EBounty.msg("info", " Setup closed without saving.")
      end
    end

    # The window, ready to show. Lists are edited on copies so Cancel discards them too.
    def form
      setup = self
      @live = form_values
      @drafts = LISTS.to_h { |key| [key, Array(@settings[key]).dup] }
      @refs = {}
      @form = Setup.form_class.new(owner: @owner, id: PAGE_ID, title: title, values: @live, fields: fields,
                                   lists: LISTS.to_h { |key| [key, list_spec(key)] },
                                   normalize: ->(draft) { setup.normalize(draft) },
                                   layout: ->(ui, field, save) { setup.layout(ui, field, save) },
                                   props: { size: [900, 820], viewport: true })
    end

    attr_reader :drafts, :live

    def apply(result)
      @settings.merge!(result)
      EBounty.save_profile(@settings)
    end

    def title
      "EBounty Setup v#{@script_ver}"
    end

    # ------------------------------------------------------ fields and values --

    def shown_keys
      @@categories[:general].keys - HIDDEN
    end

    def boolean?(key)
      [true, false].include?(Setup.get_setting(key)[:default])
    end

    def member_key(key, value)
      :"#{key}-#{value}"
    end

    def fields
      list = shown_keys.reject { |key| LISTS.include?(key) || MEMBERS.key?(key) }.map do |key|
        if SPINS.key?(key)
          max, step, digits = SPINS[key]
          { key: key, type: :number_input, min: 0, max: max, step: step, digits: digits, stepper_buttons: true, align: :start }
        elsif key == :boost_type
          { key: key, type: :select, options: BOOST_TYPES.map { |type| { value: type, label: type } } }
        elsif PROFILES.key?(key)
          { key: key, type: :select, editable: true, options: profile_options }
        elsif boolean?(key)
          { key: key, type: :checkbox, exclusive: EXCLUSIVE[key] }.compact
        else
          { key: key, type: :text_input }
        end
      end
      MEMBERS.each { |key, items| items.each { |value, _| list << { key: member_key(key, value), type: :checkbox } } }
      list
    end

    def form_values
      shown_keys.each_with_object({}) do |key, values|
        if MEMBERS.key?(key)
          MEMBERS[key].each { |value, _| values[member_key(key, value)] = Array(@settings[key]).include?(value) }
        elsif LISTS.include?(key)
          values[key] = Array(@settings[key]).dup
        elsif SPINS.key?(key)
          values[key] = spin_value(key)
        elsif key == :boost_type
          values[key] = boost_value
        elsif boolean?(key)
          values[key] = @settings[key] ? true : false
        else
          values[key] = @settings[key].to_s
        end
      end
    end

    # Display value for a spinner: inside min..max and on a step, as the contract requires.
    def spin_value(key)
      max, step, digits = SPINS.fetch(key)
      number = digits.zero? ? @settings[key].to_i : @settings[key].to_f
      ((number.clamp(0, max) / step).round * step).round(digits)
    end

    # A blank or unknown boost choice shows Any.
    def boost_value
      BOOST_TYPES.include?(@settings[:boost_type]) ? @settings[:boost_type] : 'Any'
    end

    # Turns the submitted window values back into settings. A number or choice the
    # player left as displayed keeps its saved value, even one the window had to adjust.
    def normalize(draft)
      result = shown_keys.to_h do |key|
        value =
          if MEMBERS.key?(key)
            known = MEMBERS[key].map(&:first)
            (Array(@settings[key]) - known + known.select { |item| draft[member_key(key, item)] }).uniq.sort
          elsif LISTS.include?(key)
            Array(draft[key]).dup
          elsif SPINS.key?(key)
            number_setting(key, draft[key])
          elsif key == :boost_type
            draft[key] == boost_value ? @settings[key] : draft[key].to_s
          elsif boolean?(key)
            draft[key] ? true : false
          else
            draft[key].to_s.strip
          end
        [key, value]
      end
      result[:new_bounty_on_exit] = false unless result[:once_and_done]
      # The dropdown and its name setting have always held the same name.
      PROFILES.each { |profile, name| result[name] = result[profile] unless result[profile] == @settings[profile].to_s.strip }
      result
    end

    def number_setting(key, value)
      raise ArgumentError, "#{key} must be a number." unless value.is_a?(Numeric)
      return @settings[key] if value == spin_value(key)

      max, _step, digits = SPINS.fetch(key)
      (digits.zero? ? value.round : value.to_f.round(digits)).clamp(0, max)
    end

    def profile_options
      @profile_options ||= begin
        dir = "#{$data_dir}#{XMLData.game}/#{Char.name}/bigshot_profiles"
        names = Dir.exist?(dir) ? Dir.children(dir).select { |name| name =~ /.yaml/ }.map { |name| name.sub('.yaml', '') }.sort : []
        [{ value: '', label: '' }] + names.map { |name| { value: name, label: name } }
      end
    end

    # Whether an option group's checkbox can be used by this character.
    def option_known?(key, value, spell)
      return Stats.prof =~ /rogue/i ? true : false if key == :forage_options && value == 'use_gambit'
      return Spell[604].known? && Skills.slblessings > 15 if key == :forage_options && value == 'use_604evoke'

      spell.nil? || Spell[spell].known?
    end

    # ------------------------------------------------------------------ lists --

    def list_spec(key)
      setup = self
      { columns: [{ key: 'entry', label: 'Entry', expand: true }],
        rows: proc { setup.drafts[key].map { |entry| { 'entry' => entry.to_s } } }, value: proc { setup.drafts[key].dup },
        add: ->(text) { setup.add_entry(key, text) }, delete: ->(index) { setup.delete_entry(key, index) },
        clear_after_add: true }
    end

    def add_entry(key, text)
      text = text.to_s.strip
      return if text.empty?

      list = @drafts[key]
      list.push(text) unless list.map(&:to_s).include?(text)
      sort_list(list)
    end

    def delete_entry(key, index)
      @drafts[key].delete_at(index)
      sort_list(@drafts[key])
    end

    def sort_list(list)
      list.uniq!
      list.sort_by!(&:to_s)
    end

    # ---------------------------------------------------------- live gating --

    # Run one bounty and quit enables Get new bounty before quitting; turning it
    # off clears that box too. Nothing else in this window depends on another control.
    def once_and_done_changed(value, viewer)
      @live[:once_and_done] = value
      if value
        Lich::WebUI.refresh(@form.page)
      else
        @form.page.set(@refs.fetch(:new_bounty_on_exit).cid, :checked, false, viewer: viewer) # re-renders
      end
    end

    # ------------------------------------------------------------- render --

    def control(ui, key, **props)
      @refs[key] = @field.call(ui, key, **props)
    end

    def layout(ui, field, save)
      setup = self
      @field = field
      ui.presentation(always_on_top: true)
      ui.stack(key: 'main', gap: 8, margin: 8, fill: true) do
        ui.tabs(key: 'tabs', names: TABS, selected: 0, on: { select: ->(_ev) {} }) do
          ui.scroll(slot: 'General', key: 'tab-general', fill: true) { ui.stack(key: 'tab-general-body', gap: 8) { setup.render_general(ui) } }
          ui.scroll(slot: 'Resting', key: 'tab-resting', fill: true) { ui.stack(key: 'tab-resting-body', gap: 8) { setup.render_resting(ui) } }
          ui.scroll(slot: 'Foraging', key: 'tab-foraging', fill: true) { ui.stack(key: 'tab-foraging-body', gap: 8) { setup.render_foraging(ui) } }
          ui.scroll(slot: 'Heirloom', key: 'tab-heirloom', fill: true) { ui.stack(key: 'tab-heirloom-body', gap: 8) { setup.render_heirloom(ui) } }
          ui.scroll(slot: 'Bandits', key: 'tab-bandits', fill: true) { ui.stack(key: 'tab-bandits-body', gap: 8) { setup.render_bandits(ui) } }
          ui.scroll(slot: 'Escort', key: 'tab-escort', fill: true) { ui.stack(key: 'tab-escort-body', gap: 8) { setup.render_escort(ui) } }
          ui.scroll(slot: 'Exclusions', key: 'tab-exclusions', fill: true) { ui.stack(key: 'tab-exclusions-body', gap: 8) { setup.render_exclusions(ui) } }
          ui.scroll(slot: 'Profiles', key: 'tab-profiles', fill: true) { ui.stack(key: 'tab-profiles-body', gap: 8) { setup.render_profiles(ui) } }
        end
      end
      render_footer(ui, save)
    end

    def render_general(ui)
      setup = self
      ui.group(key: 'general-types', label: 'Bounty Types') do
        setup.render_members(ui, :bounty_types, BOUNTY_TYPES, columns: 5)
      end
      ui.group(key: 'general-misc', label: 'Misc') do
        ui.columns(key: 'general-misc-cols', count: 3, gap: 8, row_align: :start) do
          ui.stack(slot: '0', key: 'general-misc-left', gap: 4) do
            setup.render_check(ui, :exp_pause, 'Rest when mind full')
            setup.render_check(ui, :keep_hunting, 'Keep hunting (?)', tip: 'When checked this will use your gem/default profile to keep hunting instead of exiting when no bounty profile is found.')
            setup.render_check(ui, :basic, 'Just the basics (?)', tip: 'Only pickup and return bounties based on settings. No automatic hunting or whatnot.')
            setup.render_check(ui, :return_to_group, 'Rejoin group before quitting (?)', tip: 'If you start in a group, try to end in the group if separated.')
          end
          ui.stack(slot: '1', key: 'general-misc-middle', gap: 4) do
            setup.render_check(ui, :skip_healing, 'Skip healing')
            setup.render_check(ui, :once_and_done, 'Run one bounty and quit',
                               on: { change: ->(ev) { setup.once_and_done_changed(ev.payload[:value] ? true : false, ev.viewer_id) } })
            setup.render_check(ui, :new_bounty_on_exit, 'Get new bounty before quitting (?)', off: !setup.live[:once_and_done],
                                                                                              tip: 'When Run one bounty and quit is enabled, grab the next task before leaving.')
            setup.render_check(ui, :remove_heirloom, 'Remove if heirloom is missing', tip: 'Remove bounty if heirloom item is missing')
          end
          ui.stack(slot: '2', key: 'general-misc-right', gap: 4) do
            setup.render_check(ui, :use_vouchers, 'Use vouchers')
            setup.render_check(ui, :use_boosts, 'Use bounty boosts')
            setup.control(ui, :boost_type, tooltip: 'Bounty choice when boost is active')
            setup.render_check(ui, :ranger_track, 'Ranger Track (?)', off: Stats.prof !~ /ranger/i, tip: 'Track bounty target on cooldown')
          end
        end
      end
      ui.group(key: 'general-scripts', label: 'Support Scripts') do
        ui.columns(key: 'general-scripts-cols', count: 2, gap: 8, row_align: :start) do
          ui.stack(slot: '0', key: 'general-scripts-left', gap: 4) do
            setup.render_inline_entry(ui, :healing_script, 'Healing Script:', hint: 'Defaults to eherb')
            setup.render_inline_entry(ui, :death_script, 'Death Recovery Script:', hint: 'Will run if character dies (optional)')
            setup.render_inline_entry(ui, :selling_script, 'Selling Script:', hint: 'Defaults to eloot')
            setup.render_inline_entry(ui, :hording_script, 'Hording Script(?):', hint: 'Runs before gem bounty (optional)',
                                                                                 tip: 'This should be the script name then any necessary parameters. Like this:  HoardingScriptName Parameters')
          end
          ui.stack(slot: '1', key: 'general-scripts-right', gap: 4) do
            setup.render_inline_entry(ui, :escort_script, 'Escort Script:', hint: 'Defaults to ego')
            setup.render_inline_entry(ui, :rescue_script, 'Rescue Script:', hint: 'Defaults to echild')
            setup.render_inline_entry(ui, :gem_history, 'Gem History:', hint: 'Tracks bounty gems (optional)',
                                                                        tip: "This script will run after being given a gem bounty.\nUseful if you want to track frequency of different gems asked for.")
          end
        end
      end
      ui.group(key: 'general-limits', label: 'Task Limits') do
        ui.columns(key: 'general-limits-cols', count: 3, gap: 8, row_align: :start) do
          ui.stack(slot: '0', key: 'general-limits-left', gap: 4) do
            setup.render_spin(ui, :culling_max, 'Max Culling Kills')
            setup.render_spin(ui, :gem_max, 'Max Gems')
          end
          ui.stack(slot: '1', key: 'general-limits-middle', gap: 4) do
            setup.render_spin(ui, :herb_max, 'Max Herbs')
            setup.render_spin(ui, :skin_max, 'Max Skins')
          end
          setup.render_spin(ui, :extra_skin, '# of extra skins (?)', slot: '2', tip: 'Number of extra skins before turn in.')
        end
      end
    end

    def render_resting(ui)
      setup = self
      ui.group(key: 'resting-options', label: 'Resting Options') do
        ui.columns(key: 'resting-cols', count: 2, gap: 8, row_align: :start) do
          ui.stack(slot: '0', key: 'resting-left', gap: 4) do
            setup.render_check(ui, :table_rest, 'Use Nearest Table')
            setup.render_check(ui, :bigshot_rest, 'Use Bigshot Resting Room')
            setup.render_check(ui, :custom_rest, 'Use Custom Resting Area(s)')
            setup.render_entry(ui, :resting_room, hint: 'Custom Resting Location(s)',
                                                  tip: "Will randomly select from this list to rest from\nIf only one location is listed it will always go there\nNeeds to be a comma separated list")
          end
          ui.stack(slot: '1', key: 'resting-right', gap: 4) do
            setup.render_check(ui, :use_script, 'Use Script to Handle Resting Location')
            setup.render_entry(ui, :use_script_name, hint: 'usage: script_name parameter1 parameter2')
            setup.render_check(ui, :join_player, 'Join Character')
            setup.render_entry(ui, :join_list, hint: 'Will try to join in order listed')
            setup.render_check(ui, :use_buff_script, 'Use Buff Script')
            setup.render_entry(ui, :buff_script, hint: 'usage: script_name parameter1 parameter2')
          end
        end
        setup.render_check(ui, :rest_random, 'Use Random Resting Areas')
        ui.columns(key: 'resting-towns', count: 2, gap: 8, row_align: :start) do
          [[RESTING_LEFT, '0'], [RESTING_RIGHT, '1']].each do |towns, slot|
            ui.stack(slot: slot, key: "resting-towns-#{slot}", gap: 4) do
              towns.each { |key, label| setup.render_inline_entry(ui, key, label) }
            end
          end
        end
        ui.text(key: 'resting-note', wrap: true, content: '*** If no selections are made the script will rest in the nexus (if shattered) or town center ***')
      end
    end

    def render_foraging(ui)
      setup = self
      ui.group(key: 'forage-options', label: 'Foraging Options') do
        setup.render_option_columns(ui, :forage_options, FORAGE_OPTIONS, weights: [5, 6, 4, 5])
      end
      render_command_group(ui, 'forage-pre', 'Pre-Foraging', [[:forage_prep_commands, 'Pre-Foraging Commands:'], [:forage_prep_scripts, 'Active Foraging Scripts:']])
      render_command_group(ui, 'forage-post', 'Post-Foraging', [[:forage_post_commands, 'Post-Foraging Commands:'], [:forage_post_scripts, 'Post-Foraging Scripts:']])
    end

    def render_heirloom(ui)
      setup = self
      ui.group(key: 'heirloom-options', label: 'Search Options') do
        setup.render_option_columns(ui, :heirloom_options, HEIRLOOM_OPTIONS, weights: [1, 1, 1, 1])
        setup.control(ui, :'heirloom_options-use_right', label: 'Flag right hand (?)', tooltip: 'Heirloom will default to right hand instead of laying on the ground.')
      end
      render_command_group(ui, 'heirloom-pre', 'Pre-Heirloom Searching', [[:heirloom_prep_commands, 'Pre-Searching Commands:'], [:heirloom_prep_scripts, 'Active Searching Scripts:']])
      render_command_group(ui, 'heirloom-post', 'Post-Heirloom Searching', [[:heirloom_post_commands, 'Post-Searching Commands:'], [:heirloom_post_scripts, 'Post-Searching Scripts:']])
    end

    def render_bandits(ui)
      setup = self
      ui.group(key: 'bandits-wander', label: 'Wander Timing') do
        setup.render_spin(ui, :wander_wait, 'Wait this long before moving rooms')
      end
      ui.group(key: 'bandits-rooms', label: 'Bad Room List') do
        ui.columns(key: 'bandits-head', count: 2, weights: [3, 5], gap: 8, compact: true) do
          ui.text(slot: '0', key: 'bandits-location', content: 'Location (?)', emphasis: :strong, tooltip: "Reference only, doesn't need to be exact")
          ui.text(slot: '1', key: 'bandits-rooms-head', content: "Bad Room Numbers (Supports UID's) (?)", emphasis: :strong, tooltip: 'Should be a comma seperated list (228, 188 ,u76564564)')
        end
        (1..12).each do |row|
          ui.columns(key: "bandits-row-#{row}", count: 2, weights: [3, 5], gap: 8, compact: true) do
            setup.render_entry(ui, :"location#{row}", slot: '0')
            setup.render_entry(ui, :"bad_room#{row}", slot: '1')
          end
        end
      end
    end

    def render_escort(ui)
      setup = self
      count = ESCORT_TOWNS.size + 1
      ui.group(key: 'escort-travel', label: 'Travel Preferences') do
        ui.columns(key: 'escort-head', count: count, gap: 4, compact: true) do
          ui.text(slot: '0', key: 'escort-corner', content: 'Start From / Destination', emphasis: :strong, wrap: true)
          ESCORT_TOWNS.each_with_index do |(_, label), column|
            ui.text(slot: (column + 1).to_s, key: "escort-to-#{column}", content: label, emphasis: :strong)
          end
        end
        ESCORT_TOWNS.each do |from, from_label|
          ui.columns(key: "escort-row-#{from}", count: count, gap: 4, compact: true, row_align: :center) do
            ui.text(slot: '0', key: "escort-from-#{from}", content: from_label, emphasis: :strong)
            ESCORT_TOWNS.each_with_index do |(to, to_label), column|
              if from == to
                ui.text(slot: (column + 1).to_s, key: "escort-same-#{from}", content: '--')
              else
                setup.control(ui, setup.member_key(:escort_types, "#{from}_to_#{to}"), slot: (column + 1).to_s, label: '', tooltip: "#{from_label} to #{to_label}")
              end
            end
          end
        end
      end
      render_command_group(ui, 'escort-pre', 'Pre-Escort', [[:escort_prep_commands, 'Pre-Escort Commands:'], [:escort_prep_scripts, 'Active Escort Scripts:']])
      render_command_group(ui, 'escort-post', 'Post-Escort', [[:escort_post_commands, 'Post-Escort Commands:'], [:escort_post_scripts, 'Post-Escort Scripts:']])
    end

    def render_exclusions(ui)
      setup = self
      ui.columns(key: 'exclusions-1', count: 2, gap: 8, row_align: :start) do
        setup.render_list(ui, :creature_exclude, 'Creature Exclusions (?)', slot: '0', hint: "Creatures you don't want bounties for")
        setup.render_list(ui, :herb_exclude, 'Herb Exclusions (?)', slot: '1', hint: "Herbs you don't want bounties for")
      end
      ui.columns(key: 'exclusions-2', count: 2, gap: 8, row_align: :start) do
        setup.render_list(ui, :gem_exclude, 'Gem Exclusions (?)', slot: '0', hint: "Gems you don't want bounties for")
        setup.render_list(ui, :location_exclude, 'Location Exclusions (?)', slot: '1', hint: "Locations you don't want bounties")
      end
    end

    def render_profiles(ui)
      setup = self
      ui.group(key: 'profiles', label: 'Profiles') do
        ui.columns(key: 'profiles-head', count: 3, weights: [3, 6, 2], gap: 8, compact: true) do
          ui.text(slot: '0', key: 'profiles-names', content: 'Creature Names (?)', emphasis: :strong, tooltip: 'Names should be seperated by commas.')
          ui.text(slot: '1', key: 'profiles-profile', content: 'Associated Profile', emphasis: :strong)
          ui.text(slot: '2', key: 'profiles-kill', content: 'Only Kill Bounty Creatures', emphasis: :strong, wrap: true)
        end
        setup.render_profile_row(ui, 'default', 'Gem/Default Profile', :default_profile, nil)
        setup.render_profile_row(ui, 'bandits', 'Bandits Profile', :bandits_profile, :kill_bandits)
        ('a'..'j').each do |letter|
          setup.render_profile_row(ui, letter, nil, :"profile_#{letter}", :"kill_#{letter}", names: :"names_#{letter}")
        end
      end
    end

    def render_footer(ui, save)
      setup = self
      ui.divider(key: 'footer-div')
      ui.columns(key: 'footer', count: 3, weights: [5, 1, 1], compact: true, row_align: :center, margin: 6) do
        ui.text(slot: '0', key: 'footer-text', wrap: true, content: 'Save & Close saves your settings. Cancel or closing the window discards your changes.')
        ui.button(slot: '1', key: 'cancel', label: 'Cancel', tooltip: 'Close this window without saving.', on: { activate: ->(_ev) { setup.cancel } })
        save.call(ui, slot: '2', variant: :primary, tooltip: 'Save the settings to your ebounty profile and close this window.')
      end
    end

    def cancel
      @form.close
    end

    # --------------------------------------------------------- render parts --

    def place(slot)
      slot ? { slot: slot } : {}
    end

    def tip_for(tip)
      tip ? { tooltip: tip } : {}
    end

    def hint_for(hint)
      hint ? { placeholder: hint } : {}
    end

    def render_check(ui, key, label, slot: nil, off: false, tip: nil, on: nil)
      control(ui, key, label: label, disabled: off, **place(slot), **tip_for(tip), **(on ? { on: on } : {}))
    end

    # Checkboxes over one array setting. items: [stored value, label]
    def render_members(ui, key, items, columns: 4)
      setup = self
      items.each_slice(columns).with_index do |group, row|
        ui.columns(key: "#{key}-#{row}", count: columns, gap: 8) do
          group.each_with_index do |(value, label), column|
            setup.control(ui, setup.member_key(key, value), slot: column.to_s, label: label)
          end
        end
      end
    end

    # Columns of checkboxes over one array setting, disabled when the character lacks them.
    def render_option_columns(ui, key, columns, weights:)
      setup = self
      ui.columns(key: "#{key}-cols", count: columns.size, weights: weights, gap: 8, row_align: :start) do
        columns.each_with_index do |items, column|
          ui.stack(slot: column.to_s, key: "#{key}-col-#{column}", gap: 4) do
            items.each do |value, label, spell|
              setup.control(ui, setup.member_key(key, value), label: label, disabled: !setup.option_known?(key, value, spell))
            end
          end
        end
      end
    end

    def render_command_group(ui, name, title, rows)
      setup = self
      ui.group(key: name, label: title) do
        rows.each { |key, label| setup.render_inline_entry(ui, key, label) }
      end
    end

    def render_entry(ui, key, slot: nil, off: false, tip: nil, hint: nil)
      control(ui, key, disabled: off, **place(slot), **tip_for(tip), **hint_for(hint))
    end

    # A text box with its label beside it instead of above it.
    def render_inline_entry(ui, key, label, tip: nil, hint: nil)
      setup = self
      ui.columns(key: "#{key}-row", count: 2, weights: [1, 2], gap: 8, compact: true, row_align: :center) do
        ui.text(slot: '0', key: "#{key}-label", content: label, **setup.tip_for(tip))
        setup.render_entry(ui, key, slot: '1', tip: tip, hint: hint)
      end
    end

    def render_spin(ui, key, label, slot: nil, tip: nil)
      control(ui, key, label: label, **place(slot), **tip_for(tip))
    end

    # An add/delete list: entry box, Add and Delete in a row, above the table.
    # The entry comes first because Add submits it.
    def render_list(ui, key, title, slot: nil, hint: nil)
      setup = self
      ui.group(key: "#{key}-box", label: title, tooltip: EXCLUSION_TIP, **place(slot)) do
        ui.columns(key: "#{key}-controls", count: 3, weights: [3, 1, 1], gap: 4, compact: true, row_align: :center) do
          setup.control(ui, :"#{key}_entry", slot: '0', **setup.hint_for(hint))
          setup.control(ui, :"#{key}_add", slot: '1', label: 'Add')
          setup.control(ui, :"#{key}_delete", slot: '2', label: 'Delete')
        end
        setup.control(ui, key, headers: false, min_height: 220, max_height: 220)
      end
    end

    def render_profile_row(ui, id, label, profile_key, kill_key, names: nil)
      setup = self
      ui.columns(key: "profile-row-#{id}", count: 3, weights: [3, 6, 2], gap: 8, compact: true, row_align: :center) do
        if names
          setup.render_entry(ui, names, slot: '0')
        else
          ui.text(slot: '0', key: "profile-label-#{id}", content: label)
        end
        setup.control(ui, profile_key, slot: '1')
        if kill_key
          setup.render_check(ui, kill_key, '', slot: '2', tip: 'Only Kill Bounty Creatures')
        else
          ui.text(slot: '2', key: "profile-nokill-#{id}", content: '')
        end
      end
    end

    # --------------------------------------------------------- other output --

    def list(cat_to_list: 'all')
      indent_size = 2
      print_array =
        proc do |key, value, indent|
          _respond("#{' ' * indent_size * indent.to_i}#{key}:")
          value.sort_by!(&:to_s).each { |entry| _respond("#{' ' * indent_size * (indent.to_i + 1)}#{value.index(entry) + 1}. #{entry}") }
        end

      print_value = proc { |key, value, indent| _respond("#{' ' * indent_size * indent.to_i}#{key}: #{value}") }

      categories = cat_to_list == 'all' ? %w[general] : [cat_to_list]
      if $frontend == 'stormfront'
        output = "<output class=\"mono\"/>\n"
      else
        output = String.new
      end
      categories.each do |opt|
        _respond("#{output}") if !output.empty?
        _respond("#{monsterbold_start}= #{opt.capitalize} =#{monsterbold_end}\n")
        @@categories[opt.to_sym].each do |id, _|
          value = @settings[id]
          value.class == Array ? print_array.call(id, value, 1) : print_value.call(id, value, 1)
        end
      end
      if $frontend == 'stormfront'
        output = "<output class=\"\"/>\n"
        _respond("#{output}")
      end
    end
  end

  module Hunting
    def self.should_hunt?
      EBounty.msg("debug", " #{__method__} | caller: #{caller[0]}")

      # Stat changes don't register until an info command is done
      if EBounty.data.info_time < Time.now
        EO.command("info", /<dialogData id='expr'>/, silent: true, quiet: true)
        EBounty.data.info_time = Time.now + 60
      end

      if Stats.enhanced_aur[0].to_i < Stats.aur[0].to_i
        EBounty.data.reason = "Recovering from Death"
        return false
      end

      bounty_available = checkbounty =~ /^You are not currently assigned / && !Effects::Cooldowns.to_h.include?('Next Bounty')
      return true if bounty_available

      if Char.percent_mana < UserVars.op['rest_till_mana'].to_i
        EBounty.data.reason = "Mana less than #{UserVars.op['rest_till_mana'].to_i}%"
        return false
      elsif Char.spirit < UserVars.op['rest_till_spirit'].to_i
        EBounty.data.reason = "Spirit less than #{UserVars.op['rest_till_spirit']}"
        return false
      elsif checkbounty =~ /^You are not currently assigned / && Effects::Cooldowns.time_left('Next Bounty') < 3 && !Effects::Cooldowns.time_left('Next Bounty').zero?
        minutes = Effects::Cooldowns.time_left('Next Bounty')
        minutes_part = minutes.to_i
        seconds_part = ((minutes - minutes_part) * 60).to_i

        EBounty.data.reason = "Next bounty available in #{minutes_part} minutes and #{seconds_part} seconds."
        return false
      elsif (percentmind > UserVars.op['rest_till_exp'].to_i) && EBounty.data.settings[:exp_pause]
        EBounty.data.reason = "Mind greater than #{UserVars.op['rest_till_exp'].to_i}%"
        return false
      elsif checkbounty =~ /^You are not currently assigned / && Effects::Cooldowns.time_left('Next Bounty').positive? && !EBounty.data.settings[:keep_hunting] && percentmind > UserVars.op['rest_till_exp'].to_i
        EBounty.data.reason = "Bounty cooldown active"
        return false
      elsif checkmind == 'saturated' && checkbounty =~ /You have succeeded/ && !EBounty.data.settings[:keep_hunting]
        EBounty.data.reason = "Bounty turn-in available but mind still saturated."
        return false
      elsif checkmind == 'saturated' && checkbounty =~ /You have succeeded/ && EBounty.data.settings[:keep_hunting]
        minutes = EBounty.check_exp
        minutes_part = minutes.to_i
        seconds_part = ((minutes - minutes_part) * 60).to_i
        if minutes < 4
          EBounty.data.reason = "Bounty turn-in available in #{minutes_part} minutes and #{seconds_part} seconds."
          sleep minutes * 60
          return false
        end
      end

      return true
    end

    def self.keep_hunting
      EBounty.msg("debug", " #{__method__} | caller: #{caller[0]}")

      original_bounty = checkbounty
      EBounty.load_default_profile

      loop do
        respond
        EBounty.msg "yellow", " No Profile found for current bounty and keep_hunting is toggled. Please check the Profiles tab."
        respond
        EBounty.msg "yellow", " Current bounty: #{checkbounty}"
        EBounty.data.rest_time = Time.now - 5

        EBounty.go2_rest if !Hunting.should_hunt?

        until Hunting.should_hunt?
          if EBounty.data.rest_time < Time.now
            respond ""
            EBounty.msg("yellow", " Not Hunting: #{EBounty.data.reason}")
            EBounty.msg("yellow", " Total Elapsed Time: #{EBounty.elapsed}")
            respond ""

            EBounty.data.rest_time = Time.now + 60
          end
          sleep 0.5
        end

        Script.run('bigshot', 'single')

        # If the bounty changed (dead child, boss kill etc.) then break out of loop and check Task.bounty_check
        break if original_bounty != checkbounty
      end

      Task.bounty_check
    end

    # The completion rule bigshot checks each tick. The rule is libeo's; the
    # string bigshot evals calls it with what the game says now.
    def self.set_eval
      EBounty.msg("debug", " #{__method__} | caller: #{caller[0]}")

      if EBounty.data.settings[:keep_hunting] || (!EBounty.data.settings[:exp_pause] && checkbounty !~ /^You are not currently assigned /)
        UserVars.op['fried'] = "101"
      end
      fried = UserVars.op['fried'].to_i

      EBounty.data.bounty_rule = EO::Guild::Completion::Rule.new(
        task: Bounty.task,
        mind_needed: EBounty.data.settings[:exp_pause] ? fried : 100,
        count_mind: [fried, 100].min,
        extra_skin: EBounty.data.settings[:extra_skin].to_i,
        keep_hunting: EBounty.data.settings[:keep_hunting] ? true : false
      )
      UserVars.op['bounty_eval'] = %q{EBounty.data.bounty_rule.complete?(bounty_text: checkbounty, mind_percent: @CORRECT_PERCENT_MIND.to_i, bandit: $bigshot_bandits ? true : false, saturated: checkmind == 'saturated', cooldown: Effects::Cooldowns.to_h.include?('Next Bounty'), containers: EBounty.data.containers, npcs: GameObj.npcs, hidden: hidden?)}

      sleep 0.2
    end

    def self.pre_hunt(type)
      EBounty.msg("debug", " #{__method__} | caller: #{caller[0]} | type: #{type}")

      commands = nil
      scripts = nil

      case type
      when /forage/i
        commands = EBounty.data.settings[:forage_prep_commands]
        scripts = EBounty.data.settings[:forage_prep_scripts]
      when /heirloom/i
        commands = EBounty.data.settings[:heirloom_prep_commands]
        scripts = EBounty.data.settings[:heirloom_prep_scripts]
      when /escort/i
        commands = EBounty.data.settings[:escort_prep_commands]
        scripts = EBounty.data.settings[:escort_prep_scripts]
      else
        commands = UserVars.op['hunting_prep_commands']
        scripts = UserVars.op['hunting_scripts']
      end

      commands.split(",").each { |i|
        if i =~ /^script\s+(.*?)(\s|$)(.*)/i
          name = $1
          args = $3
          if (args == nil || args =~ /^\s*$/)
            start_script name
          else
            args = args.split(/ /)
            start_script name, args
          end
        else
          fput(i)
          sleep(0.3)
        end
      }

      scripts.split(/,\s*/).each do |i|
        tokens = i.split(/\s+/)
        if (tokens.size > 1)
          start_script tokens[0], tokens[1..-1]
        else
          start_script tokens[0]
        end
      end
    end

    def self.post_hunt(type)
      EBounty.msg("debug", " #{__method__} | caller: #{caller[0]} | type: #{type}")

      commands = nil
      kill_scripts = nil
      scripts = nil

      case type
      when /forage/i
        commands = EBounty.data.settings[:forage_post_commands]
        kill_scripts = EBounty.data.settings[:forage_prep_scripts]
        scripts = EBounty.data.settings[:forage_post_scripts]
      when /heirloom/i
        commands = EBounty.data.settings[:heirloom_post_commands]
        kill_scripts = EBounty.data.settings[:heirloom_prep_scripts]
        scripts = EBounty.data.settings[:heirloom_post_scripts]
      when /escort/i
        commands = EBounty.data.settings[:escort_post_commands]
        kill_scripts = EBounty.data.settings[:escort_prep_scripts]
        scripts = EBounty.data.settings[:escort_post_scripts]
      else
        commands = UserVars.op['resting_commands']
        kill_scripts = UserVars.op['hunting_scripts']
        scripts = UserVars.op['resting_scripts']
      end

      unless kill_scripts.to_s.empty?
        kill_scripts.split(/,\s*/).each do |i|
          tokens = i.split(/\s+/)
          kill_script(tokens[0]) if running?(tokens[0])
        end
      end

      unless commands.to_s.empty?
        commands.split(",").each { |i|
          EBounty.msg("debug", "commands: #{i}")
          if i =~ /^script\s+(.*?)(\s|$)(.*)/i
            name = $1
            args = $3
            if (args == nil || args =~ /^\s*$/)
              Script.run(name)
            else
              args = args.split(/ /)
              Script.run(name, args)
            end
          else
            fput(i)
            sleep(0.3)
          end
        }
        EBounty.msg("debug", "End of commands")
      end

      unless scripts.to_s.empty?
        scripts.split(/,\s*/).each do |i|
          EBounty.msg("debug", "scripts: #{i}")
          tokens = i.split(/\s+/)
          if (tokens.size > 1)
            Script.run(tokens[0], tokens[1..-1].join(" "))
          else
            Script.run(tokens[0])
          end
        end
        EBounty.msg("debug", "End of scripts")
      end

      EBounty.msg("debug", "End of post_hunt: #{type}")
    end

    def self.go_hunting
      EBounty.msg("debug", " #{__method__} | caller: #{caller[0]}")

      EBounty.data.rest_time = Time.now

      EBounty.go2_rest if !Hunting.should_hunt?

      until Hunting.should_hunt?
        EBounty.check_health

        if EBounty.data.rest_time < Time.now
          respond
          if EBounty.data.converted != 0
            EBounty.msg("yellow", " Last Hunt: #{EBounty.data.converted}")
          end

          EBounty.msg("yellow", " Not Hunting: #{EBounty.data.reason}")
          EBounty.msg("yellow", " Total Elapsed Time: #{EBounty.elapsed}")
          respond

          EBounty.data.rest_time = Time.now + 60
        end
        sleep 0.5
      end

      return if checkbounty =~ /^You are not currently assigned / && !Effects::Cooldowns.to_h.include?('Next Bounty')
      return if !checkmind('saturated') && checkbounty =~ /You have succeeded/

      original_op = UserVars.op

      unless EBounty.data.creature.nil?
        if EBounty.data.creature == "bandits"
          new_target = "(?:thief|rogue|bandit|mugger|outlaw|highwayman|marauder|brigand|thug|robber)"
          UserVars.op['hunting_room_id'] = UserVars.op['rallypoint_room_ids'] = EBounty.data.location_start
          UserVars.op['hunting_boundaries'] = EBounty.data.location_boundaries
          UserVars.op['wander_wait'] = EBounty.data.settings[:wander_wait]
        else
          new_target = EBounty.data.creature.split.last + UserVars.op['targets'].match(/#{EBounty.data.creature.split.last}(\([a-j]\))/)[1].to_s
        end

        if EBounty.data.settings[:only_required_creatures]
          UserVars.op['targets'] = new_target
        else
          UserVars.op['targets'] += ",#{new_target}" if EBounty.data.creature == "bandits"
        end
      end

      Hunting.set_eval

      # Still here go hunting
      hunt_start = Process.clock_gettime(Process::CLOCK_MONOTONIC)
      if EBounty.data.settings[:ranger_track]
        Script.run('bigshot', "bounty #{Bounty.current.creature.split(' ').last}")
      else
        Script.run('bigshot', 'bounty')
      end
      hunt_end = Process.clock_gettime(Process::CLOCK_MONOTONIC)
      elapsed = hunt_end - hunt_start
      EBounty.data.converted = Time.at(elapsed).utc.strftime("%H:%M:%S")

      UserVars.op = original_op
    end
  end

  module Task
    # Hand back a task the settings do not want, then vet whatever a voucher
    # handed us in its place.
    def self.check_removal
      EBounty.msg("debug", " #{__method__} | caller: #{caller[0]}")

      return if Bounty.type == :none
      reason = EBounty.policy.reject?(Bounty.task)
      return if reason.nil?

      echo "#{reason}. Turning in bounty!"
      Task.gem_ask if Bounty.type == :gem_assignment && !EBounty.data.settings[:gem_history].to_s.empty?
      Task.bounty_remove
      if EBounty.data.settings[:once_and_done] && Effects::Cooldowns.active?("Next Bounty")
        Task.get_new_bounty_before_exit
        EBounty.go2_rest
        EBounty.exit_script
      end
      Task.check_removal
    end

    # The guild dialogue is the library's; ebounty stops, saying why, where
    # the library gives up.
    def self.ask_taskmaster(type)
      EBounty.msg("debug", " #{__method__} | caller: #{caller[0]} | type: #{type}")

      case type
      when 'get' then EO::Guild::Taskmaster.get(EBounty.policy)
      when 'turn-in' then EO::Guild::Taskmaster.ask(:turn_in)
      when 'remove' then EO::Guild::Taskmaster.ask(:remove)
      when 'expedite' then EO::Guild::Taskmaster.ask(:expedite)
      when 'failure' then EO::Guild::Taskmaster.ask(:failure)
      end
    rescue EO::Guild::Error => e
      EBounty.guild_stop(e)
    end

    def self.ask_assignment(type)
      EBounty.msg("debug", " #{__method__} | caller: #{caller[0]} | type: #{type}")

      EO::Guild::Assignments.ask(type.to_sym, town: Bounty.task.town)
    rescue EO::Guild::Error => e
      EBounty.guild_stop(e)
    end

    # Visit the guards; when the task wants a found heirloom we do not have,
    # the settings say whether to hand the task back, keep hunting, or stop.
    def self.ask_guard
      EBounty.msg("debug", " #{__method__} | caller: #{caller[0]}")

      visit = EO::Guild::Guards.ask(town: Bounty.task.town, bounty_text: checkbounty, containers: EBounty.data.containers)
      visit.opened.each { |id| EBounty.data.close_containers.push(id) unless EBounty.data.close_containers.include?(id) }

      if visit.outcome == :heirloom_missing
        if EBounty.data.settings[:remove_heirloom]
          Task.bounty_remove
          return false
        elsif EBounty.data.settings[:keep_hunting]
          EBounty.go2_rest
          Hunting.keep_hunting
        else
          EBounty.go2_rest
          EBounty.exit_script
        end
      end

      visit.outcome == :changed
    rescue EO::Guild::Error => e
      EBounty.guild_stop(e)
    end

    def self.bounty_remove(just_remove = false)
      EBounty.msg("debug", " #{__method__} | caller: #{caller[0]} | just_remove: #{just_remove}")

      EO::Guild::Taskmaster.remove(EBounty.policy, voucher: !just_remove)
    rescue EO::Guild::Error => e
      EBounty.guild_stop(e)
    end

    def self.wait_until_next_bounty_available
      EBounty.msg("debug", " #{__method__} | caller: #{caller[0]}")

      EO::Guild::Taskmaster.wait_for_cooldown
    end

    def self.forage_policy
      EO::Guild::Forage::Policy.new(options: EBounty.data.settings[:forage_options], skip_healing: EBounty.data.settings[:skip_healing])
    end

    # The herbs in the default container that answer to the task's herb.
    def self.herbs_held(herb)
      EO::Guild::Forage.in_container(StowList.stow_list[:default], herb)
    end

    def self.child_found
      EBounty.msg("debug", " #{__method__} | caller: #{caller[0]}")

      unless EO::Guild::Rescue.child_here?
        EBounty.msg("yellow", "Child not found. Please go to the room the child is in and restart the script.")
        EBounty.exit_script
      end

      EO::Guild::Rescue.run(EBounty.data.rescue_script, heal: -> { EBounty.check_health })
      EBounty.go2_rest
      Hunting.post_hunt("child")
    end

    def self.child_bounty(creature)
      EBounty.msg("debug", " #{__method__} | caller: #{caller[0]} | creature: #{creature}")

      if running? "child-bigshot"
        kill_script("child-bigshot")
        before_dying { Script.start('child-bigshot') }
      end

      EBounty.switch_profile(creature)
      EBounty.go2_rest
      Hunting.go_hunting

      return unless EO::Guild::Rescue.child_here? && EO::Guild::Rescue.contact?(checkbounty)

      EO::Guild::Rescue.run(EBounty.data.rescue_script, heal: -> { EBounty.check_health })
      EBounty.go2_rest
      Hunting.post_hunt("child")
    end

    def self.escort(pickup, dropoff)
      EBounty.msg("debug", " #{__method__} | caller: #{caller[0]} | pickup: #{pickup} dropoff: #{dropoff}")

      trip = EO::Guild::Escort.trip(pickup, dropoff)
      unless trip && EBounty.data.settings[:escort_types].include?(trip) && EBounty.data.settings[:bounty_types].include?("escort")
        Task.bounty_remove
        return
      end
      EBounty.exit_script if EBounty.data.settings[:basic]

      Hunting.pre_hunt("escort")
      EO::Guild::Escort.run(EBounty.data.escort_script)
      EBounty.go2_rest
      Hunting.post_hunt("escort")
    end

    def self.forage_bounty(herb, quantity, location = "nearest", bounty_bypass: false)
      EBounty.msg("debug", " #{__method__} | caller: #{caller[0]} | herb: #{herb} | quantity: #{quantity} | location: #{location}")

      current_room = Room.current.id
      amount = Task.herbs_held(herb).length
      nearby = location.eql?("nearest") || bounty_bypass

      if nearby
        forage_item = herb
        if amount >= quantity.to_i
          EBounty.msg("yellow", " Default container has #{amount} #{amount > 1 ? forage_item + 's' : forage_item}. Quantity requested: #{quantity.to_i}")
          EBounty.exit_script
        end
      else
        Task.forage_return if amount >= quantity.to_i
        return if Bounty.type == :taskmaster || Task.forage_turnin(herb)
        forage_item = EO::Guild::Forage.forage_item(herb)
      end

      rooms = EO::Guild::Forage.rooms(herb, forage_item, location)
      if rooms.empty?
        echo(nearby ? "No #{herb} found" : "No #{herb} found at #{location}")
        EBounty.exit_script
      end

      Hunting.pre_hunt("forage")
      hurt = if nearby
               -> { EBounty.go2_rest; EBounty.check_health }
             else
               -> { EBounty.go2_rest; Task.prep }
             end
      EO::Guild::Forage.gather(item: forage_item, count: -> { Task.herbs_held(forage_item).length }, needed: quantity.to_i,
                               rooms: rooms, policy: Task.forage_policy, sack: StowList.stow_list[:default],
                               gambit: EBounty.data.gambits_available, hurt: hurt)

      nearby ? EBounty.go2(current_room) : Task.forage_return
    end

    # Hand over the herbs when already next to the herbalist; out in the
    # field it is a waste of time.
    def self.forage_turnin(herb)
      EBounty.msg("debug", " #{__method__} | caller: #{caller[0]} | herb: #{herb}")

      return false unless EO::Guild::Forage.near_herbalist?(Bounty.task.town)

      EBounty.open_container(StowList.stow_list[:default])
      herbs = Task.herbs_held(herb.gsub(/^some /, ""))
      return false if herbs.empty?

      EO::Guild::Forage.give(herbs, Bounty.task.town)
      true
    rescue EO::Guild::Error => e
      EBounty.guild_stop(e)
    end

    def self.forage_return(recover_room: true)
      EBounty.msg("debug", " #{__method__} | caller: #{caller[0]}")

      EBounty.fog
      EBounty.go2_rest

      concoction = /The.*is working on a concoction that requires (?:a|an|some) (.*) found/
      herb = checkbounty =~ concoction ? Regexp.last_match(1).gsub(/^some /, "") : ""
      EBounty.open_container(StowList.stow_list[:default])
      herbs = Task.herbs_held(herb)
      EO::Guild::Forage.give(herbs, Bounty.task.town) if herbs.length.positive?
      fill_hands

      Hunting.post_hunt("forage")

      if checkbounty =~ concoction && recover_room
        EBounty.go2_rest
        EBounty.msg("yellow", " Didn't finish foraging task. Sleeping 3 minutes to let the room recover")
        sleep 180
      end
    rescue EO::Guild::Error => e
      EBounty.guild_stop(e)
    end

    def self.heirloom_search(critter, item)
      EBounty.msg("debug", " #{__method__} | caller: #{caller[0]} | item: #{item} | critter: #{critter}")

      EBounty.switch_profile(critter)
      Hunting.pre_hunt("heirloom")

      policy = EO::Guild::Heirloom::Policy.new(options: EBounty.data.settings[:heirloom_options])
      if policy.use?(:use_right)
        before_dying { EO.command("flag righthand off", /You will not attempt to pickup treasure using your right hand./, silent: true, quiet: true) }
      end

      EO::Guild::Heirloom.search(item: item, start: UserVars.op['hunting_room_id'], boundaries: UserVars.op['hunting_boundaries'].to_s.split(','),
                                 policy: policy, loot: -> { Script.run(EBounty.data.loot_script) })

      EBounty.go2(EO::Guild::Tables.town_room(Bounty.task.town).id)
      Hunting.post_hunt("heirloom")
    end

    def self.bounty_check(repeat: false)
      EBounty.msg("debug", " #{__method__} | caller: #{caller[0]} | checkbounty: #{checkbounty}")

      EBounty.data.creature = nil

      Task.check_removal

      if EBounty.data.settings[:basic] && Bounty.type !~ /guard|taskmaster|none|assignment|found|escort|failed/
        EBounty.exit_script
        sleep 0.5
      end

      case Bounty.type
      when :none
        if Effects::Buffs.active?("Bounty Boost")
          sleep 0.5 while Effects::Cooldowns.active?("Next Bounty")
        end
        Effects::Cooldowns.active?("Next Bounty") ? Task.wait_for_bounty : Task.bounty_get
      when :taskmaster
        Task.bounty_complete
      when :guard, :bandit_assignment, :creature_assignment, :heirloom_assignment, :rescue_assignment, :heirloom_found
        Task.ask_guard
      when :herb_assignment
        Task.forage_ask
      when :gem_assignment
        Task.gem_ask
      when :skin_assignment
        Task.skin_ask
      when :rescue
        Task.child_bounty(Bounty.task.creature)
      when :rescue_spawned
        Task.child_found
      when :bandit
        Task.bandit_bounty(Bounty.task.area)
      when :dangerous, :cull, :dangerous_spawned
        Task.creature_culling(Bounty.task.creature)
      when :herb
        Task.forage_bounty(Bounty.task.herb, Bounty.task.number, Bounty.task.area)
      when :gem
        Task.gem_bounty(Bounty.task.gem, Bounty.task.number)
      when :skin
        Task.skin_bounty(Bounty.task.creature, Bounty.task.skin, Bounty.task.number)
      when :heirloom
        Task.heirloom_bounty(Bounty.task.item, Bounty.task.creature, Bounty.task.area, Bounty.task.action)
      when :escort
        Task.escort(Bounty.task.start, Bounty.task.destination)
      when :failed
        Task.ask_taskmaster('failure')
      else
        if repeat
          EBounty.msg("warn", "Unknown Result: Unable to match bounty_check.")
          EBounty.msg("warn", "checkbounty: #{checkbounty}")
          EBounty.exit_script
        else
          # in case checkbounty not populated...
          EO.command("bounty", /<a exist=".*?your Adventurer's Guild information is as follows/i, silent: true, quiet: true)
          Task.bounty_check(repeat: true)
        end
      end

      Task.bounty_check
    end

    def self.fetch_bounty_details
      EBounty.msg("debug", " #{__method__} | caller: #{caller[0]} | type: #{Bounty.type}")

      case Bounty.type
      when :guard, :bandit_assignment, :creature_assignment, :heirloom_assignment, :rescue_assignment, :heirloom_found
        Task.ask_guard
      when :herb_assignment
        Task.forage_ask
      when :gem_assignment
        Task.gem_ask
      when :skin_assignment
        Task.skin_ask
      end

      Task.check_removal
    end

    # The task's location to a start room and boundaries, into EBounty.data.
    def self.find_location(location)
      area = EO::Guild::Location.resolve(location, avoid: EBounty.data.bad_rooms)
      EBounty.data.location_start = area.start.to_s
      EBounty.data.location_boundaries = area.boundaries.join(",")
    rescue EO::Guild::Error => e
      EBounty.msg("warn", "checkbounty: #{checkbounty}")
      EBounty.guild_stop(e)
    end

    # Breadth-first crawl from +start_id+, restricted to rooms in +location_list+,
    # returning a contiguous subset of at most +max_rooms+ room ids. Used to cap
    # large hunting locations to a manageable, connected region around the start.
    # @param start_id [Integer, String] seed room id (nearest location room)
    # @param location_list [Array<Integer>] full set of room ids within the location
    # @param max_rooms [Integer] hard cap on the number of rooms returned
    # @return [Array<Integer>] contiguous subset of +location_list+, size <= max_rooms
    def self.bandit_bounty(location)
      EBounty.msg("debug", " #{__method__} | caller: #{caller[0]} | location: #{location}")

      EBounty.switch_profile("bandits")
      Task.find_location(location)
      before_dying { $bigshot_bandits = false }
      Hunting.go_hunting
    end

    def self.bounty_complete
      EBounty.msg("debug", " #{__method__} | caller: #{caller[0]}")

      unless EBounty.data.settings[:basic]
        # Make sure the default profile is loaded
        EBounty.load_default_profile
      end

      if checkmind("saturated")
        EBounty.go2_rest
        EBounty.exit_script if EBounty.data.settings[:basic] || EBounty.data.settings[:once_and_done]
        Task.prep
      end

      # Hang out until not satuarated
      until !checkmind("saturated")
        EBounty.exit_script if (EBounty.data.settings[:basic] || EBounty.data.settings[:once_and_done])
        sleep 0.5
        Hunting.go_hunting if EBounty.data.settings[:keep_hunting]
      end

      # Turn in the bounty
      Task.ask_taskmaster('turn-in')

      if EBounty.data.settings[:basic]
        EBounty.silver_deposit
        return
      end

      if EBounty.data.settings[:once_and_done]
        EBounty.silver_deposit
        Task.get_new_bounty_before_exit
        EBounty.go2_rest
        EBounty.exit_script
      end

      Task.prep
    end

    def self.bounty_get
      EBounty.msg("debug", " #{__method__} | caller: #{caller[0]}")

      Task.ask_taskmaster('get')
    end

    def self.creature_culling(creature)
      EBounty.msg("debug", " #{__method__} | caller: #{caller[0]} | creature: #{creature}")

      EBounty.switch_profile(creature)
      Hunting.go_hunting
    end

    def self.forage_ask
      EBounty.msg("debug", " #{__method__} | caller: #{caller[0]}")
      Task.ask_assignment('herbalist')
    end

    def self.gem_ask
      EBounty.msg("debug", " #{__method__} | caller: #{caller[0]}")
      Task.ask_assignment('jeweler')
      unless EBounty.data.settings[:gem_history].to_s.empty?
        EBounty.run_scripts(EBounty.data.settings[:gem_history])
      end
    end

    def self.gem_bounty(kind = nil, amount = nil)
      EBounty.msg("debug", " #{__method__} | caller: #{caller[0]} | kind: #{kind} | amount: #{amount}")

      # Run bounty script here
      unless EBounty.data.settings[:hording_script].to_s.empty?
        EBounty.data.settings[:hording_script].split(/,\s*/).each do |i|
          tokens = i.split(/\s+/)
          if (tokens.size > 1)
            Script.run(tokens[0], tokens[1..-1].to_s)
          else
            Script.run(tokens[0])
          end
        end
      end

      # the hoarding script may have handled selling the gems
      if checkbounty =~ /succeeded in your task/
        return
      end

      # Lets check if we have enough gems to turn in already
      EBounty.data.containers.each { |container| EBounty.open_container(container) }
      count = EO::Guild::Completion.gems_held(EBounty.data.containers, kind)

      if count >= amount.to_i
        if EBounty.data.loot_script == 'eloot' && defined?(ELoot) && !ELoot.data.settings[:sell_loot_types].include?("gem")
          EBounty.msg("error", " You've choosen to not sell gems via ;eloot sell! Please handle gem bounty manually!")
          EBounty.exit_script
        else
          Task.prep(no_check: true)
        end
      else
        EBounty.load_default_profile
        Hunting.go_hunting
      end
    end

    def self.heirloom_bounty(item = nil, critter = nil, location = nil, type = nil)
      EBounty.msg("debug", " #{__method__} | caller: #{caller[0]} | item: #{item} | critter: #{critter} | location: #{location} | type: #{type}")

      case type
      when /loot/i
        EBounty.switch_profile(critter)
        Hunting.go_hunting
      when /search/i
        Task.heirloom_search(critter, item)
      end
    end

    def self.skin_ask
      EBounty.msg("debug", " #{__method__} | caller: #{caller[0]}")
      Task.ask_assignment('furrier')
    end

    def self.skin_bounty(creature, skin, quantity)
      EBounty.msg("debug", " #{__method__} | caller: #{caller[0]} | creature: #{creature} | skin: #{skin} | quantity: #{quantity}")

      needed = quantity.to_i + EBounty.data.settings[:extra_skin].to_i
      EBounty.msg("debug", "skins needed: #{needed}")

      # Lets check if we have enough skins to turn in already
      EBounty.data.containers.each { |container| EBounty.open_container(container) }
      count = EO::Guild::Completion.skins_held(EBounty.data.containers, skin, hidden: hidden?)

      if count >= needed
        if EBounty.data.loot_script == 'eloot' && defined?(ELoot) && !ELoot.data.settings[:sell_loot_types].include?("skin")
          EBounty.msg("error", " You've choosen to not sell skins via ;eloot sell! Please handle skin bounty manually!")
          EBounty.exit_script
        else
          Task.prep(no_check: true)
        end
      else
        EBounty.switch_profile(creature)
        Hunting.go_hunting
      end
    end

    def self.prep(no_check: false)
      EBounty.msg("debug", " #{__method__} | caller: #{caller[0]}")

      EBounty.check_health

      start_room = Room.current.id

      if StowList.stow_list[:default].contents.any? { |item| !item.sellable.nil? || item.type =~ /box/ } || no_check
        Script.run(EBounty.data.loot_script, 'sell')
      end

      EBounty.silver_deposit
      EBounty.go2(start_room)
    end

    def self.get_new_bounty_before_exit
      EBounty.msg("debug", " #{__method__} | caller: #{caller[0]}")

      return unless EBounty.data.settings[:once_and_done]
      return unless EBounty.data.settings[:new_bounty_on_exit]

      Task.wait_until_next_bounty_available

      unless Bounty.type == :none || checkbounty =~ /^You are not currently assigned /
        EBounty.msg("debug", "Skipping new bounty request because a task is still active.")
        return
      end

      Task.bounty_get
      Task.fetch_bounty_details
      Task.check_removal
    end

    def self.wait_for_bounty
      EBounty.msg("debug", " #{__method__} | caller: #{caller[0]}")

      if EBounty.data.settings[:use_boosts] && EO::Guild::Taskmaster.boosts.positive? && !Effects::Buffs.active?("Bounty Boost")
        EO::Guild::Taskmaster.boost!
      elsif Effects::Buffs.active?("Bounty Boost")
        sleep 4
      elsif EBounty.data.settings[:basic]
        EBounty.exit_script
      else
        EBounty.load_default_profile
        Hunting.go_hunting
      end
    end
  end
end

current_op = UserVars.op

before_dying {
  EBounty.go2(EBounty.data.start_room) if EBounty.data.settings[:basic]
  EBounty.regroup if EBounty.data.settings[:return_to_group]
  Script.kill("bigshot") if Script.running?("bigshot")
  UserVars.op = current_op
}

if Script.current.vars[1] =~ /ver/i
  echo "EBounty Version: #{EBounty.get_script_version}"
  exit
end

# Initialize default settings
unless EBounty.data
  EBounty.load(EBounty.load_profile())
end

unless Room.current.id.nil?
  EBounty.data.start_room = Room.current.id
end

if EBounty.data.settings[:return_to_group]
  EBounty.data.settings[:leader] = Lich::Gemstone::Group.leader.to_s.capitalize
end

unless EBounty.data.settings[:basic] || Script.current.vars[1] =~ /basic/i
  required_scripts = %w(bigshot)
  required_scripts.push("eherbs")    if EBounty.data.settings[:healing_script].to_s.empty? && !EBounty.data.settings[:skip_healing]
  required_scripts.push("eloot")     if EBounty.data.settings[:selling_script].to_s.empty?
  required_scripts.push("echild")    if EBounty.data.settings[:rescue_script].to_s.empty? && EBounty.data.settings[:bounty_types].include?("rescue")
  required_scripts.push("escortgo2") if EBounty.data.settings[:escort_script].to_s.empty? && EBounty.data.settings[:bounty_types].include?("escort")
  required_scripts_missing = required_scripts.select { |s| !Script.exists?(s) }
  if required_scripts_missing.count > 0
    echo("You must also download the following script#{required_scripts_missing.count > 1 ? 's' : ''} to use ebounty:  " + required_scripts_missing.join(', '))
    exit
  end
end

case Script.current.vars[1]
when nil, /once/, /basic/i
  if Script.current.vars[1] =~ /once/
    basic_setting = EBounty.data.settings[:basic]
    EBounty.data.settings[:basic] = false

    once_settings = EBounty.data.settings[:once_and_done]
    EBounty.data.settings[:once_and_done] = true

    before_dying do
      EBounty.data.settings[:basic] = basic_setting
      EBounty.data.settings[:once_and_done] = once_settings
    end
  elsif Script.current.vars[1] =~ /basic/i
    # Single run with just the basics enabled, without persisting the override to the profile
    basic_setting = EBounty.data.settings[:basic]
    EBounty.data.settings[:basic] = true

    before_dying do
      EBounty.data.settings[:basic] = basic_setting
    end
  end

  if Room.current.id.nil?
    EBounty.msg "error", 'Please start ebounty in a mapped room.'
    exit
  else
    EBounty.data.start_room = Room.current.id
  end

  current_settings = UserVars.op
  EBounty.over_watch
  EBounty.set_variables
  EBounty.data.close_containers = []

  before_dying do
    UserVars.op = current_settings

    # Close any containers we had to open. Uses dothistimeout, not get_command:
    # Lich runs kill cleanup with interrupts deferred, so the Timeout inside
    # Lich::Util.issue_command can't fire and an unrecognized close reply
    # (custom container messages) would hang the script forever.
    EBounty.msg("debug", "before_dying | EBounty.data.close_containers: #{EBounty.data.close_containers}")
    Script.current.silent = true unless EBounty.data.close_containers.empty?
    EBounty.data.close_containers.each do |bag_id|
      dothistimeout("close ##{bag_id}", 3, /^You\b|\bis (?:already closed|closed already)\b|What were you referring to|seem to be any way to do that|exist="#{bag_id}"/)
    end
  end

  EBounty::Task.bounty_check
when 'debug'
  respond
  EBounty.update_setting(['debug', "#{!EBounty.data.settings[:debug]}"])
  EBounty.data.settings[:debug] = !EBounty.data.settings[:debug]
  respond
when 'list'
  EBounty::Setup.new(EBounty.load_profile).list
when /settings|setup/
  if Script.current.vars[2] =~ /^help$/i
    EBounty.settings_help
  elsif Script.current.vars[2]
    EBounty.update_setting(Script.current.vars[2..-1])
  else
    if EBounty::Setup.available?
      EBounty::Setup.new(EBounty.load_profile).start
      EBounty.load(EBounty.load_profile)
      EBounty.set_variables
    else
      EBounty.settings_cli_notice
    end
  end
when 'load'
  EBounty.load(EBounty.load_profile)
  EBounty.set_variables
when 'remove'
  if Room.current.id.nil?
    EBounty.msg "error", 'Please start ebounty in mapped room.'
    exit
  else
    EBounty.data.start_room = Room.current.id
  end
  EBounty::Task.bounty_remove(true)
  EBounty.go2(EBounty.data.start_room)
when 'forage'
  if Script.current.vars[2].nil? || (Script.current.vars[3].nil? && Script.current.vars[2] != 'bounty')
    EBounty.msg "error", ' Please use one of the following proper syntax for the forage option:'
    EBounty.msg "error", ' To search closest 10 rooms for foraged herb:'
    EBounty.msg "error", ' Autodetect Bounty:     ;ebounty forage bounty'
    EBounty.msg "error", ' Manual Bounty:         ;ebounty forage bounty "Output here from BOUNTY output"'
    EBounty.msg "error", ' Closest 10 Rooms:      ;ebounty forage "herb to find" <how many>'
    EBounty.msg "error", ' All Rooms At Location: ;ebounty forage "herb to find" <how many> "location to search"'
    exit
  end
  return_room = Room.current.id
  EBounty.load(EBounty.load_profile)
  EBounty.set_variables(load_profile: false)
  if Script.current.vars[2] == 'bounty'
    bounty_info =
      if Script.current.vars[3].to_s.strip.empty?
        Bounty.task
      else
        begin
          Bounty::Task.new(Bounty::Parser.parse(Script.current.vars[3]))
        rescue StandardError => e
          EBounty.msg "error", " Unable to parse manual BOUNTY text: #{e.message}"
          exit
        end
      end

    unless bounty_info&.herb?
      EBounty.msg "error", ' Started ebounty with ;ebounty forage bounty'
      EBounty.msg "error", ' But you have no herb bounty!'
      EBounty.msg "error", " #{bounty_info.inspect}"
      exit
    end
    EBounty::Task.forage_bounty(bounty_info.herb, bounty_info.number, bounty_info.area, bounty_bypass: !Script.current.vars[3].to_s.strip.empty?)
  elsif Script.current.vars[4].is_a?(String)
    EBounty::Task.forage_bounty(Script.current.vars[2], Script.current.vars[3].to_i, Script.current.vars[4], bounty_bypass: true)
  else
    EBounty::Task.forage_bounty(Script.current.vars[2], Script.current.vars[3].to_i)
  end
  EBounty.go2(return_room)
when /location/i
  if Bounty.task.requirements[:area].nil?
    respond
    EBounty.msg "yellow", " No location specified for the current bounty. | Bounty: #{Bounty.task.requirements.inspect}"
    respond
  else
    respond
    EBounty.msg "yellow", " Bounty Location: #{Bounty.task.area}"
    respond
  end
when /creature/i
  if Bounty.task.requirements[:creature].nil?
    respond
    EBounty.msg "yellow", " No creature specified for the current bounty. | Bounty: #{Bounty.task.requirements.inspect}"
    respond
  else
    respond
    EBounty.msg "yellow", " Bounty Creature: #{Bounty.task.creature}"
    respond
  end
when /bounty/i
  rows = []

  Bounty.task.instance_variables.map { |var|
    next if Bounty.task.instance_variable_get(var).nil?
    if var =~ /requirements/
      Bounty.requirements.each { |key, value|
        next if key =~ /town/
        next if value.nil?
        rows << ["Bounty.task.#{key}", value]
      }
    else
      rows << [var.to_s.gsub('@', 'Bounty.'), Bounty.task.instance_variable_get(var).to_s]
    end
  }

  respond
  respond Terminal::Table.new :title => "Current Bounty", :rows => rows
  respond
when 'test'
  EBounty.test
else
  EBounty.help
end
